# Non-English language packs are managed by Moodle's own translation system
# (AMOS, https://lang.moodle.org/) once this plugin is registered in the
# Moodle plugins directory, not by this repository. Keeping only lang/en/
# here avoids this repo and AMOS fighting over the same files.
lang/*
!lang/en/
!lang/en/**

# Local moodle-plugin-ci runs (composer create-project ... ci ^4, per
# ci.yml's own "Initialise moodle-plugin-ci" step) and its Composer
# dependencies -- never committed, CI creates its own copy every run.
/ci/
/vendor/
composer.lock

# Behat faildumps from a local run, and PHPUnit's own cache.
/moodledata/
.phpunit.cache/
