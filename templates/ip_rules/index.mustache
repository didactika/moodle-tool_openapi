{{!
    @template tool_openapi/ip_rules/index

    The IP rule list, with the create button above it and an empty state in
    place of the table when there are no rules.

    Context variables required for this template:
    * heading - Section heading
    * backurl / backlabel - The way back to the access method this configures
    * createurl / createlabel - The create button
    * hasrules - Whether there is at least one row
    * rows - Rules, each with iprange, description, scope, status, actions
    * emptymessage - Shown instead of the table when hasrules is false
    * headers - Column headings: iprange, description, scope, status

    Example context (json):
    {
        "heading": "IP rules",
        "backurl": "https://example.com/access_control/index.php",
        "backlabel": "Back to access methods",
        "createurl": "https://example.com/create.php",
        "createlabel": "Add IP rule",
        "hasrules": true,
        "emptymessage": "No IP rules yet.",
        "headers": {
            "iprange": "IP address or CIDR range",
            "description": "Description",
            "scope": "Allowed functions",
            "status": "Status"
        },
        "rows": [
            {
                "iprange": "192.0.2.0/24",
                "description": "Office",
                "scope": "Full catalog",
                "status": "Enabled",
                "actions": "<a href=\"#\"></a>"
            }
        ]
    }
}}
{{> tool_openapi/local/back_link}}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">{{heading}}</h3>
    <a href="{{createurl}}" class="btn btn-primary">
        {{#pix}}t/add, core{{/pix}} {{createlabel}}
    </a>
</div>

{{#hasrules}}
    <table class="table table-hover">
        <caption class="sr-only">{{heading}}</caption>
        <thead>
            <tr>
                <th scope="col">{{headers.iprange}}</th>
                <th scope="col">{{headers.description}}</th>
                <th scope="col">{{headers.scope}}</th>
                <th scope="col">{{headers.status}}</th>
                <th scope="col"><span class="sr-only">{{#str}}actions{{/str}}</span></th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
                <tr>
                    <th scope="row" class="font-weight-bold">{{iprange}}</th>
                    <td>{{description}}</td>
                    <td>{{scope}}</td>
                    <td>{{status}}</td>
                    <td class="text-right">{{{actions}}}</td>
                </tr>
            {{/rows}}
        </tbody>
    </table>
{{/hasrules}}
{{^hasrules}}
    {{> tool_openapi/local/empty_state}}
{{/hasrules}}
